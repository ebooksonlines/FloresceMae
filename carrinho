<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mãe que Vence</title>
</head>
<body>

    <h1Document</h1>
    <p>This is a properly structured HTML5 document.</p>

</body>
</html>


<div class="carrinho-container">
  <h2>Meu Carrinho</h2>
  <div class="lista-itens">
    <!-- Exemplo de item no carrinho -->
    <div class="item-carrinho">
      <span class="nome-produto">Nome do Produto</span>
      <span class="preco-produto">R$ 29,90</span>
      <input type="number" value="1" min="1" class="qtd-produto">
      <button class="btn-remover">Remover</button>
    </div>
  </div>
  <div class="total-carrinho">
    <h3>Total: <span id="valor-total">R$ 29,90</span></h3>
    <button class="btn-finalizar">Finalizar Compra</button>
  </div>
</div>
document.addEventListener("DOMContentLoaded", () => {
  const inputQuantidade = document.querySelector(".qtd-produto");
  const precoTotalSpan = document.getElementById("valor-total");
  const itemCarrinho = document.querySelector(".item-carrinho");
  const btnRemover = document.querySelector(".btn-remover");
  const btnFinalizar = document.querySelector(".btn-finalizar");

  // Preço fixo do produto conforme solicitado
  const precoUnitario = 29.90;

  // Função para formatar o valor no padrão de moeda Real (R$)
  function formatarMoeda(valor) {
    return valor.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
  }

  // Função para recalcular o valor total do carrinho
  function atualizarTotal() {
    if (!inputQuantidade) return;
    
    const quantidade = parseInt(inputQuantidade.value) || 0;
    const total = quantidade * precoUnitario;
    
    precoTotalSpan.textContent = formatarMoeda(total);
  }

  // Escuta mudanças no campo de quantidade (digitação ou setas)
  if (inputQuantidade) {
    inputQuantidade.addEventListener("input", atualizarTotal);
  }

  // Remove o item da tela e zera o total ao clicar em "Remover"
  if (btnRemover) {
    btnRemover.addEventListener("click", () => {
      itemCarrinho.remove();
      precoTotalSpan.textContent = formatarMoeda(0);
    });
  }

  // Evento simples para o botão de finalizar compra
  if (btnFinalizar) {
    btnFinalizar.addEventListener("click", () => {
      alert("Compra finalizada com sucesso!");
    });
  }
});
<body></body>
